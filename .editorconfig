root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust, Python and build metadata
[*.rs]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{toml,json,jsonl,yml,yaml}]
indent_size = 2
max_line_length = 100

[*.{c,cc,cpp,cxx,h,hpp,hxx}]
indent_size = 2
max_line_length = 100

[*.md]
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = true

[*.{diff,patch}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4

[*.{sh,bash,zsh}]
indent_size = 2
max_line_length = 80

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4

[*.sbe]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
