{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kj111422.github.io/schemas/research/strategy-artifact.v1.json",
  "title": "Strategy Candidate Artifact v1",
  "description": "Frozen contract (P0-07). Output of the Alpha Factory: a validated candidate with its economic hypothesis and full experiment lineage. Never an automatic live-trading authorization.",
  "type": "object",
  "required": [
    "candidate_id",
    "hypothesis",
    "return_source",
    "universe",
    "entry_rule",
    "exit_rule",
    "experiment_ids",
    "validation",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "candidate id (frozen v1 semantics)"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "description": "Economic rationale for why a return should exist."
    },
    "return_source": {
      "type": "string",
      "enum": [
        "momentum",
        "mean_reversion",
        "carry",
        "microstructure",
        "volatility_risk_premium",
        "event_response",
        "other"
      ],
      "description": "return source (frozen v1 semantics)"
    },
    "universe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "universe (frozen v1 semantics)"
    },
    "entry_rule": {
      "type": "string",
      "minLength": 1,
      "description": "Deterministic rule in the restricted strategy DSL."
    },
    "exit_rule": {
      "type": "string",
      "minLength": 1,
      "description": "exit rule (frozen v1 semantics)"
    },
    "rebalance_frequency": {
      "type": "string",
      "enum": [
        "intraday",
        "daily",
        "weekly",
        "monthly"
      ],
      "description": "rebalance frequency (frozen v1 semantics)"
    },
    "experiment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Reproducible experiment records, including failed trials."
    },
    "validation": {
      "type": "object",
      "required": [
        "walk_forward_windows",
        "holdout_locked",
        "multiple_testing_correction",
        "deflated_sharpe",
        "cost_model"
      ],
      "properties": {
        "walk_forward_windows": {
          "type": "integer",
          "minimum": 1
        },
        "holdout_locked": {
          "type": "boolean"
        },
        "multiple_testing_correction": {
          "type": "string",
          "enum": [
            "benjamini_hochberg",
            "bonferroni",
            "white_reality_check"
          ]
        },
        "deflated_sharpe": {
          "type": "number"
        },
        "probability_of_backtest_overfit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cost_model": {
          "type": "string",
          "minLength": 1
        },
        "capacity_estimate_notional_paise": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "description": "validation (frozen v1 semantics)"
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "validated",
        "approved_for_paper",
        "rejected",
        "retired"
      ],
      "description": "status (frozen v1 semantics)"
    }
  }
}
