{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirnay.dev/schemas/providers/source-product-registry.v1.schema.json",
  "title": "Nirnay source product and entitlement registry v1",
  "description": "Declares what each enabled market-data product actually supplies. Absence of a capability is a rejection, not an inference. This registry makes no claim that rights or entitlements have been verified unless verified is true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/product"
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "product",
        "venue",
        "segment",
        "instrument_scope",
        "depth_model",
        "depth_levels",
        "trade_prints",
        "order_level_identity",
        "snapshot",
        "incremental_updates",
        "source_sequence",
        "recovery",
        "protocol",
        "entitlement",
        "rights",
        "limits"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "segment": {
          "type": "string",
          "minLength": 1
        },
        "instrument_scope": {
          "type": "string",
          "minLength": 1
        },
        "depth_model": {
          "enum": [
            "mbp",
            "mbo"
          ]
        },
        "depth_levels": {
          "type": "integer",
          "minimum": 0
        },
        "trade_prints": {
          "type": "boolean"
        },
        "order_level_identity": {
          "type": "boolean"
        },
        "snapshot": {
          "type": "boolean"
        },
        "incremental_updates": {
          "enum": [
            "snapshot_only",
            "delta"
          ]
        },
        "source_sequence": {
          "enum": [
            "unavailable",
            "connection",
            "provider_instrument",
            "channel"
          ]
        },
        "recovery": {
          "type": "array",
          "items": {
            "enum": [
              "reconnect",
              "fresh_snapshot",
              "retransmission"
            ]
          }
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "entitlement": {
          "$ref": "#/$defs/entitlement"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "verified"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture",
        "store",
        "replay",
        "redistribute"
      ],
      "properties": {
        "capture": {
          "type": "boolean"
        },
        "store": {
          "type": "boolean"
        },
        "replay": {
          "type": "boolean"
        },
        "redistribute": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_symbols",
        "connections"
      ],
      "properties": {
        "max_symbols": {
          "type": "integer",
          "minimum": 1
        },
        "connections": {
          "type": "integer",
          "minimum": 1
        },
        "requests_per_second": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
