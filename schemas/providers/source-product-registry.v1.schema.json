{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirnay.dev/schemas/providers/source-product-registry.v1.schema.json",
  "title": "Nirnay source product and entitlement registry v1",
  "description": "Declares what each enabled market-data product actually supplies. Absence of a capability is a rejection, not an inference. Rights are tri-state with evidence provenance; UNKNOWN never grants a right.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "rights_review",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "rights_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "review_date",
        "required_evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "review_date": {
          "type": "string",
          "format": "date"
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "product",
        "venue",
        "segment",
        "instrument_scope",
        "depth_model",
        "depth_levels",
        "trade_prints",
        "order_level_identity",
        "snapshot",
        "incremental_updates",
        "source_sequence",
        "recovery",
        "protocol",
        "entitlement",
        "rights",
        "limits"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "segment": {
          "type": "string",
          "minLength": 1
        },
        "instrument_scope": {
          "type": "string",
          "minLength": 1
        },
        "depth_model": {
          "enum": [
            "mbp",
            "mbo"
          ]
        },
        "depth_levels": {
          "type": "integer",
          "minimum": 0
        },
        "trade_prints": {
          "type": "boolean"
        },
        "order_level_identity": {
          "type": "boolean"
        },
        "snapshot": {
          "type": "boolean"
        },
        "incremental_updates": {
          "enum": [
            "snapshot_only",
            "delta"
          ]
        },
        "source_sequence": {
          "enum": [
            "unavailable",
            "connection",
            "provider_instrument",
            "channel"
          ]
        },
        "recovery": {
          "type": "array",
          "items": {
            "enum": [
              "reconnect",
              "fresh_snapshot",
              "retransmission"
            ]
          }
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "entitlement": {
          "$ref": "#/$defs/entitlement"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "incremental_updates": {
                "const": "snapshot_only"
              }
            },
            "required": [
              "incremental_updates"
            ]
          },
          "then": {
            "properties": {
              "snapshot": {
                "const": true
              }
            },
            "required": [
              "snapshot"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "recovery": {
                "contains": {
                  "const": "fresh_snapshot"
                }
              }
            },
            "required": [
              "recovery"
            ]
          },
          "then": {
            "properties": {
              "snapshot": {
                "const": true
              }
            },
            "required": [
              "snapshot"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "depth_model": {
                "const": "mbo"
              }
            },
            "required": [
              "depth_model"
            ]
          },
          "then": {
            "properties": {
              "order_level_identity": {
                "const": true
              }
            },
            "required": [
              "order_level_identity"
            ]
          }
        }
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "verified"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture",
        "store",
        "replay",
        "backup",
        "internal_analytics",
        "external_redistribution",
        "retention",
        "retention_period"
      ],
      "properties": {
        "capture": {
          "$ref": "#/$defs/right_evidence"
        },
        "store": {
          "$ref": "#/$defs/right_evidence"
        },
        "replay": {
          "$ref": "#/$defs/right_evidence"
        },
        "backup": {
          "$ref": "#/$defs/right_evidence"
        },
        "internal_analytics": {
          "$ref": "#/$defs/right_evidence"
        },
        "external_redistribution": {
          "$ref": "#/$defs/right_evidence"
        },
        "retention": {
          "$ref": "#/$defs/right_evidence"
        },
        "retention_period": {
          "$ref": "#/$defs/retention_period"
        }
      }
    },
    "right_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source",
        "document_reference",
        "scope",
        "review_date"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "PERMITTED",
            "PROHIBITED"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "owner_reported",
            "provider_agreement",
            "exchange_rules",
            "internal_policy",
            "none"
          ]
        },
        "document_reference": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "review_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "retention_period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_days",
        "basis",
        "document_reference",
        "review_date"
      ],
      "properties": {
        "duration_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "basis": {
          "type": "string",
          "enum": [
            "owner_reported",
            "provider_agreement",
            "exchange_rules",
            "internal_policy",
            "none"
          ]
        },
        "document_reference": {
          "type": "string",
          "minLength": 1
        },
        "review_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_symbols",
        "connections"
      ],
      "properties": {
        "max_symbols": {
          "type": "integer",
          "minimum": 1
        },
        "connections": {
          "type": "integer",
          "minimum": 1
        },
        "requests_per_second": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
