{
  "_comment": "Apply with: gh api --method POST /repos/<owner>/<repo>/rulesets --input <file>. Requires a plan that supports rulesets on private repositories (GitHub Pro or higher, or a public repository); the GitHub API refuses both rulesets on the free plan. Apply the branch ruleset first, then the tag ruleset.",
  "branch_ruleset": {
    "name": "main: protected release source",
    "target": "branch",
    "enforcement": "active",
    "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
    "rules": [
      { "type": "deletion" },
      { "type": "non_fast_forward" },
      {
        "type": "pull_request",
        "parameters": {
          "required_approving_review_count": 0,
          "dismiss_stale_reviews_on_push": false,
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_review_thread_resolution": true,
          "allowed_merge_methods": ["squash"]
        }
      },
      {
        "type": "required_status_checks",
        "parameters": {
          "strict_required_status_checks_policy": true,
          "do_not_enforce_on_create": true,
          "required_status_checks": [
            { "context": "rust" },
            { "context": "extras-rust" },
            { "context": "cpp" },
            { "context": "python-research" },
            { "context": "python-provider (kite)" },
            { "context": "python-provider (fyers)" },
            { "context": "provider-boundary" },
            { "context": "supply-chain" },
            { "context": "packaging" },
            { "context": "macos" }
          ]
        }
      }
    ],
    "bypass_actors": []
  },
  "tag_ruleset": {
    "name": "v* tags: release authority only",
    "target": "tag",
    "enforcement": "active",
    "conditions": { "ref_name": { "include": ["refs/tags/v*"], "exclude": [] } },
    "rules": [{ "type": "creation" }, { "type": "update" }, { "type": "deletion" }],
    "bypass_actors": [
      { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
    ]
  },
  "required_check_names_source": "gh pr checks <number> --json name — names are recorded exactly as GitHub reports them; the provider matrix is named in ci.yml so the contexts are stable."
}
